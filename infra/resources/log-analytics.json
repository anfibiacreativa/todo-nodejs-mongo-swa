        "description": "Resource tags."
      }
    },
    "location": {
      "type": "string",
      "metadata": {
        "description": "Resource location."
      }
    },
    "logAnalyticsName": {
      "type": "string",
      "metadata": {
        "description": "The name of the log Analytics workspace. e.g. log-demo"
