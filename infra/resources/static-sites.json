    }
  },
  "parameters": {
    "tags": {
      "type": "object",
      "metadata": {
        "description": "Resource tags."
      }
    },
    "location": {
      "type": "string",
      "metadata": {
        "description": "Resource location."
      }
    },
    "sku": {
      "type": "object",
      "defaultValue": {
        "name": "Free",
        "tier": "Free"
      },
      "metadata": {
        "description": "The SKU for the static site."
      }
    },
    "allowConfigFileUpdates": {
      "type": "bool",
      "defaultValue": true,
      "metadata": {
        "description": "Lock the config file for this static web app. https://docs.microsoft.com/en-us/azure/templates/microsoft.web/staticsites?tabs=bicep#staticsite"
      }
    },
    "staticSiteName": {
      "type": "string",
      "metadata": {
        "description": "The name of the static site resource. eg stapp-swa-app"
      }
    },
    "appSettings": {
      "type": "secureObject",
      "defaultValue": {},
      "metadata": {
        "description": "Configuration for the static site."
      }
    },
    "buildProperties": {
      "type": "object",
      "defaultValue": {},
      "metadata": {
        "description": "Build properties for the static site."
      }
    },
    "stagingEnvironmentPolicy": {
      "type": "string",
      "defaultValue": "Enabled",
      "allowedValues": [
        "Disabled",
        "Enabled"
      ],
      "metadata": {
        "description": "State indicating whether staging environments are allowed or not allowed for a static web app."
      }
    },
    "templateProperties": {
      "type": "object",
      "defaultValue": {},
      "metadata": {
        "description": "Template Options for the static site. https://docs.microsoft.com/en-us/azure/templates/microsoft.web/staticsites?tabs=bicep#staticsitetemplateoptions"
      }
    },
    "userAssignedIdentityId": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Resource ID of the user-assigned managed identity."
      }
    }
  },
  "resources": [
    {
      "type": "Microsoft.Web/staticSites",
      "apiVersion": "2022-03-01",
      "name": "[parameters('staticSiteName')]",
      "location": "[parameters('location')]",
      "tags": "[union(parameters('tags'), createObject('azd-service-name', 'swa'))]",
      "sku": "[parameters('sku')]",
      "identity": "[if(not(empty(parameters('userAssignedIdentityId'))), createObject('type', 'UserAssigned', 'userAssignedIdentities', createObject(format('{0}', parameters('userAssignedIdentityId')), createObject())), null())]",
      "properties": {
        "provider": "Custom",
        "allowConfigFileUpdates": "[parameters('allowConfigFileUpdates')]",
        "buildProperties": "[if(empty(parameters('buildProperties')), null(), parameters('buildProperties'))]",
        "stagingEnvironmentPolicy": "[parameters('stagingEnvironmentPolicy')]",
        "templateProperties": "[if(empty(parameters('templateProperties')), null(), parameters('templateProperties'))]"
      }
    },
    {
      "type": "Microsoft.Web/staticSites/config",
      "apiVersion": "2022-03-01",
      "name": "[format('{0}/{1}', parameters('staticSiteName'), 'appsettings')]",
      "kind": "config",
      "properties": "[parameters('appSettings')]",
      "dependsOn": [
        "[resourceId('Microsoft.Web/staticSites', parameters('staticSiteName'))]"
      ]
    }
  ],
  "outputs": {
    "defaultHostName": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Web/staticSites', parameters('staticSiteName')), '2022-03-01').defaultHostname]"
    },
    "siteName": {
      "type": "string",
      "value": "[parameters('staticSiteName')]"
    },
    "siteResourceId": {
      "type": "string",
      "value": "[resourceId('Microsoft.Web/staticSites', parameters('staticSiteName'))]"
    }
  }
